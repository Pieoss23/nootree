# Copy this file to .env.local for local development.
# Never commit real secrets.

# --- Required -----------------------------------------------------------

# PostgreSQL connection string (see docs/setup/database.md).
DATABASE_URL="postgresql://nootree:nootree@localhost:5439/nootree"

# Public base URL of the app, used for links generated server-side (magic
# links, Stripe redirects, etc). Must be a client-safe value.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# development | test | production. Next.js sets this automatically in most
# cases; only override it if you know you need to.
NODE_ENV="development"

# --- Required in production, optional in development --------------------

# Secret used to sign auth tokens/sessions once Auth.js is wired up.
# Generate one with: openssl rand -base64 32
AUTH_SECRET=""

# --- Optional: only needed when the related module is enabled -----------

# Only used by DB integration tests (pnpm test), so they never touch the
# development database. Point it at a disposable local database.
TEST_DATABASE_URL="postgresql://nootree:nootree@localhost:5439/nootree_test"

# Resend (transactional email). Required once notifications go live.
RESEND_API_KEY=""
RESEND_FROM_EMAIL=""

# Stripe (billing). Required once billing goes live.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
